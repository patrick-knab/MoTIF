# Ignore all checkpoint files with .pkl extension
*.pkl
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx

# Ignore local secrets and environment files
.env
.env.*
!.env.example

# Also ignore common Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-vllm/
.pytest_cache/
/pe_l14_ssv2_ft50/
/tests/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore logs and experiment outputs
*.log
runs/
wandb/

# Keep only placeholders in artifact folders
Models/*
!Models/info.txt

Embeddings/*
!Embeddings/info.txt

# Ignore raw and derived dataset payloads while keeping lightweight metadata
Datasets/**/Data/
Datasets/**/Video_data/
Datasets/**/Image_data/
Datasets/**/frames/
Datasets/**/embeddings/
!Datasets/info.txt

# Outputs of the agentic concept extraction and backbone adaptation runs
/concept_extraction_out_batch/
/pe_l14_ssv2_*/
/slurm_logs/
